# OpenAI-compatible endpoint (Ollama, llama.cpp, etc.)
OPENAI_BASE_URL=http://fedora:11434/v1
# API key (Ollama ignores this but SDK requires it)
OPENAI_API_KEY=ollama
# Chat model name
OPENAI_CHAT_MODEL=gemma3:1b
# Embedding model name
OPENAI_EMBED_MODEL=embeddinggemma

# Discord bot token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# SQLite database path (defaults to ./data.db)
DATABASE_PATH=./data.db